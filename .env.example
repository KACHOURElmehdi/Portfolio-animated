# Contact Form SMTP Configuration
GMAIL_APP_PASSWORD=your_gmail_app_password

# Google Analytics Configuration
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Google Search Console — paste only the content value from the meta tag
# Example meta: <meta name="google-site-verification" content="AbCdEf123..." />
# Then set: NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=AbCdEf123...
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Production site URL (used for sitemap, robots, and Open Graph)
NEXT_PUBLIC_SITE_URL=https://aymen-rguig.vercel.app
